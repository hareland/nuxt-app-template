{
  "name": "nuxt-app-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate",
    "db:clear": "rm -rf ./.data/db",
    "db:seed": "curl -X POST http://localhost:${APP_PORT:-3000}/_nitro/tasks/db:seed",
    "db:seed:users": "curl -X POST http://localhost:${APP_PORT:-3000}/_nitro/tasks/db:seed:users",
    "prepare:env": "if [ ! -f .env ]; then cp .env.example .env; else echo '.env file already exists'; fi;",
    "prepare:certs": "sh ./scripts/create-certs.sh"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.92",
    "@internationalized/date": "^3.12.2",
    "@libsql/client": "^0.17.4",
    "@norbiros/nuxt-auto-form": "^0.6.2",
    "@nuxt/image": "^2.1.0",
    "@nuxt/kit": "^4.5.1",
    "@nuxt/test-utils": "4.1.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxthub/core": "0.10.8",
    "@paralleldrive/cuid2": "^3.3.0",
    "@pinia/colada": "^1.3.1",
    "@pinia/colada-nuxt": "1.0.1",
    "@pinia/nuxt": "0.11.3",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.3.0",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "defu": "^6.1.7",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.1",
    "nuxt-auth-utils": "0.5.30",
    "pinia": "^3.0.4",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.3",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@playwright/test": "^1.62.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "happy-dom": "^20.11.1",
    "playwright-core": "^1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@11.18.0"
}
